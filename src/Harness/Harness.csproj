<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Harness</RootNamespace>
    <EnableConfigurationBindingGenerator>false</EnableConfigurationBindingGenerator>
    <HarnessEf Condition="$(MatrixTrackAEf.Contains(';$(Ef);'))">true</HarnessEf>
    <HarnessNewOnly Condition="$(MsExt) &gt;= $(NewOnlyMinMajor)">true</HarnessNewOnly>
    <DefineConstants Condition="'$(HarnessEf)' == 'true'">$(DefineConstants);HARNESS_EF</DefineConstants>
    <DefineConstants Condition="'$(HarnessNewOnly)' == 'true'">$(DefineConstants);HARNESS_NEWONLY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Scenarios/NewOnly/**" />
    <Compile Remove="Scenarios/EfScenario.cs" Condition="'$(HarnessEf)' != 'true'" />
    <AssemblyMetadata Include="ExpectedMajor:msext" Value="$(MsExt)" />
    <AssemblyMetadata Include="ExpectedMajor:ef" Value="$(Ef)" Condition="'$(HarnessEf)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Harness.Core/Harness.Core.csproj" />
    <ProjectReference Include="Scenarios/NewOnly/Harness.NewOnly.csproj" Condition="'$(HarnessNewOnly)' == 'true'" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EmberTrace.Generator" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>
  <ItemGroup Condition="'$(HarnessEf)' == 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>
</Project>
